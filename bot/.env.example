# --- LLM (free tier) ---
# Get one at https://console.groq.com (no card required)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant

# --- Telegram bot ---
# Create with @BotFather on Telegram, then copy the token here.
TELEGRAM_BOT_TOKEN=123456789:AA-your-telegram-bot-token-here
# Path-secret used in the webhook URL (any random string you choose).
TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-string
# Your personal chat id, used to receive lead notifications via Telegram.
# To get it: message your bot once, then visit
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy the value of result[0].message.chat.id
ADMIN_CHAT_ID=

# --- Public URL (used to register the Telegram webhook on startup) ---
# Leave blank for local development with polling.
# Set to your Render URL in production, e.g. https://ebby-bot.onrender.com
PUBLIC_BASE_URL=

# --- Lead admin endpoint ---
# Bearer token required to call GET /leads
ADMIN_API_TOKEN=change-me-too

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
# Use "*" while developing; set to your real site origin in production,
# e.g. https://ebby.co.ke,https://www.ebby.co.ke
ALLOWED_ORIGINS=*

# --- Optional: SMTP email notifications ---
# Leave SMTP_HOST empty to disable email and rely on Telegram only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
